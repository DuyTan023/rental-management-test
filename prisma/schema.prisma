generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model password_reset_otps {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  otp_hash   String    @unique @db.VarChar(255)
  attempts   Int       @default(0)
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id                   BigInt                 @id @default(autoincrement())
  email                String                 @unique @db.VarChar(255)
  password_hash        String?                @db.VarChar(255)
  role                 account_role
  status               account_status         @default(INACTIVE)
  activated_at         DateTime?              @db.Timestamptz(6)
  last_login_at        DateTime?              @db.Timestamptz(6)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  deposit_transactions deposit_transactions[]
  invitations          invitations[]
  password_reset_otps  password_reset_otps[]
  profiles             profiles?
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model profiles {
  id               BigInt             @id @default(autoincrement())
  user_id          BigInt?            @unique
  full_name        String             @db.VarChar(255)
  phone            String             @db.VarChar(20)
  identity_number  String?            @unique @db.VarChar(50)
  date_of_birth    DateTime?          @db.Date
  province_code    String?            @db.VarChar(20)
  ward_code        String?            @db.VarChar(20)
  address_detail   String?
  avatar_url       String?
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  contract_tenants contract_tenants[]
  users            users?             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model rooms {
  id               BigInt             @id @default(autoincrement())
  room_number      String             @unique @db.VarChar(20)
  area             Decimal            @db.Decimal(10, 2)
  max_occupants    Int
  listed_rent      Decimal            @db.Decimal(15, 2)
  status           room_status        @default(AVAILABLE)
  description      String?
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  rental_contracts rental_contracts[]
  room_services    room_services[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model invitations {
  id          BigInt            @id @default(autoincrement())
  user_id     BigInt
  token_hash  String            @unique @db.VarChar(255)
  status      invitation_status @default(PENDING)
  expires_at  DateTime          @db.Timestamptz(6)
  accepted_at DateTime?         @db.Timestamptz(6)
  created_at  DateTime          @default(now()) @db.Timestamptz(6)
  users       users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model contract_price_adjustments {
  id               BigInt           @id @default(autoincrement())
  contract_id      BigInt
  effective_date   DateTime         @db.Date
  new_rent_price   Decimal          @db.Decimal(15, 2)
  reason           String?
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  rental_contracts rental_contracts @relation(fields: [contract_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model contract_tenants {
  id               BigInt                 @id @default(autoincrement())
  contract_id      BigInt
  profile_id       BigInt
  role             contract_tenant_role   @default(MEMBER)
  joined_at        DateTime               @db.Date
  left_at          DateTime?              @db.Date
  left_reason      String?
  status           contract_tenant_status @default(ACTIVE)
  created_at       DateTime               @default(now()) @db.Timestamptz(6)
  updated_at       DateTime               @default(now()) @db.Timestamptz(6)
  rental_contracts rental_contracts       @relation(fields: [contract_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profiles         profiles               @relation(fields: [profile_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([contract_id, profile_id], map: "uq_contract_tenant")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model rental_contracts {
  id                         BigInt                       @id @default(autoincrement())
  room_id                    BigInt
  contract_number            String                       @unique @db.VarChar(50)
  start_date                 DateTime                     @db.Date
  end_date                   DateTime?                    @db.Date
  rent_price                 Decimal                      @db.Decimal(15, 2)
  billing_day                Int                          @db.SmallInt
  status                     rental_contract_status       @default(DRAFT)
  document_urls              String[]
  terminated_at              DateTime?                    @db.Timestamptz(6)
  termination_date           DateTime?                    @db.Date
  termination_reason         String?
  termination_requested_by   termination_requested_by?
  note                       String?
  created_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  contract_deposits          contract_deposits[]
  contract_price_adjustments contract_price_adjustments[]
  contract_tenants           contract_tenants[]
  rooms                      rooms                        @relation(fields: [room_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model contract_deposits {
  id                   BigInt                 @id @default(autoincrement())
  contract_id          BigInt
  initial_amount       Decimal                @default(0) @db.Decimal(15, 2)
  status               deposit_status         @default(NOT_RECEIVED)
  received_date        DateTime?              @db.Date
  refunded_amount      Decimal                @default(0) @db.Decimal(15, 2)
  deducted_amount      Decimal                @default(0) @db.Decimal(15, 2)
  deduction_reason     String?
  settled_date         DateTime?              @db.Date
  note                 String?
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  updated_at           DateTime               @default(now()) @db.Timestamptz(6)
  rental_contracts     rental_contracts       @relation(fields: [contract_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  deposit_transactions deposit_transactions[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model deposit_transactions {
  id                  BigInt                   @id @default(autoincrement())
  contract_deposit_id BigInt
  type                deposit_transaction_type
  amount              Decimal                  @db.Decimal(15, 2)
  transaction_date    DateTime                 @default(dbgenerated("CURRENT_DATE")) @db.Date
  description         String?
  created_by          BigInt?
  created_at          DateTime                 @default(now()) @db.Timestamptz(6)
  contract_deposits   contract_deposits        @relation(fields: [contract_deposit_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users               users?                   @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model room_services {
  id             BigInt    @id @default(autoincrement())
  room_id        BigInt
  service_id     BigInt
  unit_price     Decimal   @db.Decimal(15, 2)
  effective_from DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  effective_to   DateTime? @db.Date
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  rooms          rooms     @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  services       services  @relation(fields: [service_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([room_id, service_id, effective_from], map: "uq_room_service_period")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model services {
  id                 BigInt          @id @default(autoincrement())
  name               String          @db.VarChar(100)
  unit               String          @db.VarChar(20)
  type               service_type
  default_unit_price Decimal         @default(0) @db.Decimal(15, 2)
  is_active          Boolean         @default(true)
  created_at         DateTime        @default(now()) @db.Timestamptz(6)
  updated_at         DateTime        @default(now()) @db.Timestamptz(6)
  room_services      room_services[]
}

enum account_role {
  LANDLORD
  TENANT
}

enum account_status {
  ACTIVE
  INACTIVE
  LOCKED
}

enum room_status {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  INACTIVE
}

enum invitation_status {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum contract_tenant_role {
  REPRESENTATIVE
  MEMBER
}

enum contract_tenant_status {
  ACTIVE
  LEFT
}

enum rental_contract_status {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
  COMPLETED
}

enum termination_requested_by {
  LANDLORD
  TENANT
  BOTH
}

enum deposit_status {
  NOT_RECEIVED
  RECEIVED
  REFUNDED
  PARTIALLY_DEDUCTED
  FULLY_DEDUCTED
  SETTLED
}

enum deposit_transaction_type {
  COLLECT
  REFUND
  DEDUCT
  ADJUSTMENT
}

enum meter_type {
  ELECTRICITY
  WATER
}

enum service_type {
  METERED
  FIXED_PER_MONTH
  FIXED_PER_HEAD
}
